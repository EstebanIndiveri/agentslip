{
  "name": "agentslip",
  "version": "0.1.2",
  "private": true,
  "description": "Receipts for your coding agents. Claude Code and Codex hooks that print a thermal ESC/POS slip or a virtual paper roll.",
  "type": "module",
  "bin": {
    "agentslip": "dist/cli.js"
  },
  "files": [
    "dist",
    "viewer/dist",
    "!**/*.map"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "npm run build",
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json && vite build --config viewer/vite.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p viewer/tsconfig.json",
    "test": "npm run build && vitest run && playwright test",
    "test:unit": "vitest run",
    "test:viewer": "playwright test",
    "viewer": "vite --config viewer/vite.config.ts",
    "demo": "node dist/cli.js test",
    "record-demo": "node scripts/record-demo.mjs",
    "social-preview": "node scripts/make-social-preview.mjs",
    "build:pages": "node scripts/build-pages.mjs"
  },
  "keywords": [
    "claude-code",
    "claude-code-hooks",
    "codex",
    "codex-cli",
    "escpos",
    "esc-pos",
    "thermal-printer",
    "receipt-printer",
    "receipt",
    "hooks",
    "notifications",
    "coding-agent",
    "cli"
  ],
  "license": "MIT",
  "dependencies": {
    "receiptline": "4.0.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.18.11",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^4.1.12"
  }
}
